<!doctype html>
<html lang="en" data-theme="default">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#000000">
<title>{{.Title}}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" data-theme-style="default">
<style id="base">
  [hidden] { display: none !important; }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    display: none;
    place-items: center;
  }

  .lightbox[open] { display: grid; }

  .lightbox::backdrop { background: transparent; }

  .lightbox figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
  }

  .lightbox img {
    display: block;
    max-width: min(100%, 1600px);
    max-height: calc(100vh - 140px);
    object-fit: contain;
  }

  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    line-height: 1;
    cursor: pointer;
  }

  .lb-close { top: 20px; right: 20px; }
  .lb-prev { left: 20px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 20px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 720px) {
    .lightbox { padding: 16px; }
    .lightbox img { max-height: calc(100vh - 200px); }
    .lb-close { top: 14px; right: 14px; }
    .lb-prev, .lb-next { top: auto; bottom: 14px; transform: none; }
    .lb-prev { left: 14px; }
    .lb-next { right: 14px; }
  }
</style>

<style id="theme-metro" data-theme-style="metro" disabled>
  :root {
    --concrete: #d8d6d0;
    --paper: #f2f1ec;
    --ink: #000000;
    --flickr-pink: #ff0084;
    --flickr-blue: #0063dc;
    --taxi: #ffd400;
    --stripe: #1b1b1b;
    --border: 4px solid var(--ink);
    --shadow: 6px 6px 0 var(--ink);
    --font-display: "Helvetica Neue", Helvetica, Arial, "Liberation Sans", sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    background: var(--concrete);
    font-family: var(--font-display);
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    color: var(--ink);
    background-color: var(--concrete);
    background-image:
      linear-gradient(90deg, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(0deg, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  a {
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  a:visited { color: inherit; }

  a:focus-visible,
  .lb-btn:focus-visible,
  .theme-select:focus-visible,
  .more-btn:focus-visible {
    outline: 4px solid var(--flickr-pink);
    outline-offset: 2px;
  }

  ::selection {
    background: var(--taxi);
    color: var(--ink);
  }

  .site {
    max-width: 1200px;
    margin: 0 auto;
    background: var(--paper);
    border-left: var(--border);
    border-right: var(--border);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--ink);
    color: var(--paper);
    border-bottom: var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    min-width: 0;
  }

  .dots {
    display: inline-flex;
    gap: 4px;
    flex: none;
  }

  .dots span {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
  }

  .dots .pink { background: var(--flickr-pink); }
  .dots .blue { background: var(--flickr-blue); }

  .wordmark {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wordmark a { display: inline-block; }

  .toolbar {
    display: flex;
    align-items: stretch;
  }

  .count {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0 20px;
    background: var(--taxi);
    color: var(--ink);
    border-left: var(--border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .theme-picker {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border-left: var(--border);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .theme-select {
    padding: 4px 6px;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    text-transform: uppercase;
    cursor: pointer;
  }

  main { flex: 1; padding: 28px 24px 40px; }

  .album + .album { margin-top: 48px; }

  .album-title {
    display: flex;
    align-items: center;
    margin: 0 0 20px;
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    border: var(--border);
    width: fit-content;
    max-width: 100%;
    box-shadow: var(--shadow);
    background: var(--paper);
  }

  .album-title::before {
    content: "";
    align-self: stretch;
    width: 14px;
    background: repeating-linear-gradient(-45deg, var(--ink) 0 4px, var(--taxi) 4px 8px);
    border-right: var(--border);
  }

  .album-title .album-name {
    padding: 8px 16px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .album-title .album-count {
    align-self: stretch;
    display: flex;
    align-items: center;
    padding: 8px 14px;
    background: var(--ink);
    color: var(--taxi);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    border-left: var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure { margin: 0; }

  .photo {
    display: block;
    position: relative;
    border: var(--border);
    background: var(--ink);
    transition: transform 120ms steps(3), box-shadow 120ms steps(3);
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.9);
  }

  .photo::after {
    content: "";
    position: absolute;
    right: -4px;
    top: -4px;
    width: 26px;
    height: 26px;
    border: var(--border);
    background: linear-gradient(90deg, var(--flickr-pink) 50%, var(--flickr-blue) 50%);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 120ms steps(2);
  }

  figcaption {
    margin-top: 8px;
    min-height: 1.2em;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  .more-btn {
    padding: 10px 22px;
    border: var(--border);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (hover: hover) {
    .photo:hover {
      transform: translate(-4px, -4px);
      box-shadow: var(--shadow);
    }

    .photo:hover::after { opacity: 1; }

    .more-btn:hover { background: var(--taxi); }
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding: 14px 20px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  footer .flickr-pink { color: var(--flickr-pink); }
  footer .flickr-blue { color: var(--flickr-blue); }

  .lightbox {
    background: rgba(0, 0, 0, 0.94);
    color: var(--paper);
  }

  .lightbox img {
    border: 6px solid var(--paper);
    box-shadow: 10px 10px 0 var(--flickr-pink);
    background: var(--stripe);
  }

  .lightbox figcaption {
    margin: 0;
    padding: 6px 12px;
    background: var(--taxi);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    white-space: normal;
  }

  .lb-btn {
    border: 3px solid var(--paper);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    transition: background-color 80ms steps(2), color 80ms steps(2);
  }

  @media (hover: hover) {
    .lb-btn:hover { background: var(--taxi); color: var(--ink); }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo, .photo::after, .lb-btn { transition: none; }
  }

  @media (prefers-contrast: more) {
    .photo, .lb-btn { border-width: 5px; }
  }

  @media (max-width: 720px) {
    .wordmark { font-size: 1.2rem; }
    .theme-label { display: none; }
    main { padding: 20px 14px 32px; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  }
</style>

<style id="theme-terminal" data-theme-style="terminal" disabled>
  :root {
    color-scheme: dark;
    --bg: #0a0a0c;
    --surface: #141417;
    --surface-raised: #1c1c21;
    --fg: #f4f4f5;
    --muted: #9b9ba6;
    --faint: #5c5c66;
    --accent: #3ddc97;
    --accent-soft: rgba(61, 220, 151, 0.14);
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.16);
    --hover: rgba(255, 255, 255, 0.06);
    --radius-lg: 22px;
    --radius-md: 12px;
    --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    scrollbar-color: var(--surface-raised) var(--bg);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    background: var(--bg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-height: 100vh;
    min-height: 100svh;
    margin: 0;
    padding: 24px;
    display: grid;
    place-items: center;
    color: var(--fg);
    background-color: var(--bg);
    background-image:
      radial-gradient(60% 45% at 50% 0%, rgba(61, 220, 151, 0.12), transparent 70%),
      radial-gradient(40% 35% at 85% 100%, rgba(90, 120, 255, 0.07), transparent 70%);
    background-repeat: no-repeat;
  }

  a {
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  a:visited { color: inherit; }

  a:focus-visible,
  .lb-btn:focus-visible,
  .theme-select:focus-visible,
  .more-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  .site {
    width: min(100%, 1040px);
    padding: 28px;
    display: flex;
    flex-direction: column;
    font-size: 16px;
    line-height: 1.5;
    background: linear-gradient(180deg, #17171b 0%, var(--surface) 100%);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 1px 2px rgba(0, 0, 0, 0.4),
      0 8px 16px -4px rgba(0, 0, 0, 0.5),
      0 32px 64px -16px rgba(0, 0, 0, 0.75);
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    min-width: 0;
  }

  .dots { display: none; }

  .wordmark {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .wordmark a { display: inline-block; }

  .wordmark a::after {
    content: "";
    display: inline-block;
    width: 0.4em;
    height: 0.8em;
    margin-left: 0.12em;
    vertical-align: -0.06em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .count {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .theme-picker {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .theme-select {
    padding: 6px 10px;
    background: var(--surface-raised);
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }

  main {
    flex: 1;
    padding-top: 24px;
  }

  .album + .album { margin-top: 32px; }

  .album-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .album-title .album-count {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.7rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure { margin: 0; }

  .photo {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    box-shadow: 0 4px 10px -2px rgba(0, 0, 0, 0.5);
    transition: box-shadow 140ms ease, border-color 140ms ease;
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  figcaption {
    margin-top: 8px;
    padding: 0 2px;
    min-height: 1.2em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }

  .more-btn {
    padding: 8px 18px;
    background: var(--surface-raised);
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 140ms ease, border-color 140ms ease;
  }

  @media (hover: hover) {
    .photo:hover {
      border-color: var(--line-strong);
      box-shadow: 0 0 0 3px var(--accent-soft), 0 6px 14px -4px rgba(0, 0, 0, 0.6);
    }

    .photo:hover img { transform: scale(1.04); }

    .more-btn:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }

  footer .flickr-pink,
  footer .flickr-blue { color: var(--accent); }

  .lightbox {
    background: rgba(10, 10, 12, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--fg);
  }

  .lightbox img {
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    box-shadow: 0 32px 64px -16px rgba(0, 0, 0, 0.75);
    background: var(--surface);
  }

  .lightbox figcaption {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
    white-space: normal;
  }

  .lb-btn {
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, var(--surface-raised), #17171b);
    border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 10px -2px rgba(0, 0, 0, 0.5);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    transition: color 140ms ease, transform 140ms ease;
  }

  @media (hover: hover) {
    .lb-btn:hover { color: var(--accent); }
    .lb-prev:hover, .lb-next:hover { transform: translateY(-50%) translateY(-1px); }
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark a::after { animation: none; }
    .photo, .photo img, .more-btn, .lb-btn { transition: none; }
  }

  @media (prefers-contrast: more) {
    .site { background: var(--bg); border-color: var(--fg); }
    .photo, .lb-btn { border: 1px solid var(--fg); }
  }

  @media (max-width: 480px) {
    body { padding: 16px; }
    .site { padding: 22px; }
    .wordmark { font-size: 1.6rem; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
    .lb-prev:hover, .lb-next:hover { transform: translateY(-1px); }
  }
</style>

<style id="theme-default-overrides" data-theme-style="default" disabled>
  .lightbox {
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox figcaption {
    color: var(--bs-light);
    text-align: center;
  }

  .lightbox img {
    background: var(--bs-dark);
  }
</style>

<script>
(function () {
  var names = ["default", "metro", "terminal"];
  var saved = "default";
  try { saved = localStorage.getItem("gthumb-theme") || saved; } catch (e) {}
  if (names.indexOf(saved) < 0) saved = "default";
  document.querySelectorAll("[data-theme-style]").forEach(function (el) {
    el.disabled = el.dataset.themeStyle !== saved;
  });
  document.documentElement.dataset.theme = saved;
  window.gthumbSetTheme = function (name) {
    if (names.indexOf(name) < 0) name = "default";
    document.querySelectorAll("[data-theme-style]").forEach(function (el) {
      el.disabled = el.dataset.themeStyle !== name;
    });
    document.documentElement.dataset.theme = name;
    try { localStorage.setItem("gthumb-theme", name); } catch (e) {}
  };
})();
</script>
</head>
<body>
<div class="site">
  <header class="topbar d-flex flex-wrap justify-content-between align-items-center gap-3 px-3 py-3 border-bottom">
    <div class="brand">
      <span class="dots" aria-hidden="true"><span class="pink"></span><span class="blue"></span></span>
      <h1 class="wordmark h4 fw-bold mb-0"><a href="index.html">{{.Title}}</a></h1>
    </div>
    <div class="toolbar d-flex align-items-center gap-3">
      <p class="count small text-body-secondary mb-0">{{.Total}} {{if eq .Total 1}}photo{{else}}photos{{end}} / {{len .Albums}} {{if eq (len .Albums) 1}}album{{else}}albums{{end}}</p>
      <label class="theme-picker d-flex align-items-center gap-2 small mb-0">
        <span class="theme-label">Theme</span>
        <select id="theme-select" class="theme-select form-select form-select-sm">
          <option value="default">Default</option>
          <option value="metro">Metro</option>
          <option value="terminal">Terminal</option>
        </select>
      </label>
    </div>
  </header>

  <main class="gallery container-fluid px-3 py-4">
    {{- range .Albums}}
    <section class="album mb-5">
      <h2 class="album-title h5 d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
        <span class="album-name">{{.Title}}</span>
        <span class="album-count">{{len .Photos}}</span>
      </h2>
      <ul class="grid row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 list-unstyled mb-0" role="list">
        {{- range .Photos}}
        <li class="photo-item col"{{if .Hidden}} hidden{{end}}>
          <figure>
            <a class="photo d-block" href="{{.Full}}">
              <img class="img-fluid rounded border" src="{{.Thumb}}" alt="{{.Name}}" loading="lazy" decoding="async">
            </a>
            <figcaption class="small text-body-secondary text-truncate mt-1">
              {{- if .Taken}}{{.Taken}}{{end}}
              {{- if and .Taken .Camera}} / {{end}}
              {{- if .Camera}}{{.Camera}}{{end}}
            </figcaption>
          </figure>
        </li>
        {{- end}}
      </ul>
      {{- if gt .Hidden 0}}
      <div class="more d-flex justify-content-center mt-3">
        <button type="button" class="more-btn btn btn-outline-secondary btn-sm" data-expand>Show all {{len .Photos}}</button>
      </div>
      {{- end}}
    </section>
    {{- end}}
  </main>

  <footer class="d-flex justify-content-between small text-body-secondary border-top px-3 py-3 mt-4">
    <span>Generated with gthumb</span>
    <span><span class="flickr-pink">&bull;</span> <span class="flickr-blue">&bull;</span></span>
  </footer>
</div>

<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <figure>
    <img id="lightbox-img" src="" alt="">
    <figcaption id="lightbox-caption"></figcaption>
  </figure>
  <button class="lb-btn lb-close btn btn-light" type="button" aria-label="Close" data-action="close">&times;</button>
  <button class="lb-btn lb-prev btn btn-light" type="button" aria-label="Previous photo" data-action="prev">&larr;</button>
  <button class="lb-btn lb-next btn btn-light" type="button" aria-label="Next photo" data-action="next">&rarr;</button>
</dialog>

<script>
(() => {
  const links = Array.from(document.querySelectorAll("a.photo"));
  const dialog = document.getElementById("lightbox");
  const image = document.getElementById("lightbox-img");
  const caption = document.getElementById("lightbox-caption");
  const select = document.getElementById("theme-select");
  let current = 0;

  select.value = document.documentElement.dataset.theme;
  select.addEventListener("change", (event) => window.gthumbSetTheme(event.target.value));

  document.querySelectorAll("[data-expand]").forEach((button) => {
    button.addEventListener("click", () => {
      button.closest(".album").querySelectorAll(".photo-item[hidden]").forEach((item) => {
        item.hidden = false;
      });
      button.parentElement.hidden = true;
    });
  });

  const show = (index) => {
    current = (index + links.length) % links.length;
    const link = links[current];
    const thumb = link.querySelector("img");
    const text = link.closest("figure").querySelector("figcaption").textContent;
    image.src = link.href;
    image.alt = thumb.alt;
    caption.textContent = text.replace(/\s+/g, " ").trim();
  };

  links.forEach((link, index) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      show(index);
      dialog.showModal();
    });
  });

  dialog.addEventListener("click", (event) => {
    const action = event.target.dataset.action;
    if (action === "close") dialog.close();
    else if (action === "prev") show(current - 1);
    else if (action === "next") show(current + 1);
    else if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") show(current - 1);
    else if (event.key === "ArrowRight") show(current + 1);
  });
})();
</script>
</body>
</html>
